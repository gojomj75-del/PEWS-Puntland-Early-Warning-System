<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — " : "")PEWS — Puntland Early Warning System</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/pews.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="pews-body">

@if (User.Identity?.IsAuthenticated == true)
{
    <nav id="sidebar" class="pews-sidebar">
        <div class="sidebar-brand">
            <div class="brand-logo">
                <i class="fas fa-shield-halved"></i>
            </div>
            <div class="brand-text">
                <span class="brand-title">PEWS</span>
                <span class="brand-subtitle">Early Warning System</span>
            </div>
        </div>

        <div class="sidebar-user">
            <div class="user-avatar">
                @{ var userInitial = User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U"; }
                <span>@userInitial</span>
            </div>
            <div class="user-info">
                <span class="user-name">@User.Identity?.Name?.Split('@')[0]</span>
                @if (User.IsInRole("SuperAdmin"))
                { <span class="badge bg-danger">Super Admin</span> }
                else if (User.IsInRole("Admin"))
                { <span class="badge bg-warning text-dark">Admin</span> }
                else if (User.IsInRole("EmergencyOfficer"))
                { <span class="badge bg-primary">Officer</span> }
                else
                { <span class="badge bg-secondary">Citizen</span> }
            </div>
        </div>

        <ul class="sidebar-nav list-unstyled">
            <li class="nav-label">Main</li>
            <li>
                <a asp-controller="Dashboard" asp-action="Index"
                   class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="fas fa-gauge-high"></i><span>Dashboard</span>
                </a>
            </li>

            <li class="nav-label">Disaster Management</li>
            <li>
                <a asp-controller="DisasterReports" asp-action="Index"
                   class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Reports" ? "active" : "")">
                    <i class="fas fa-file-circle-exclamation"></i><span>Disaster Reports</span>
                </a>
            </li>
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("EmergencyOfficer"))
            {
                <li>
                    <a asp-controller="UserReports" asp-action="Index"
                       class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "UserReports" ? "active" : "")">
                        <i class="fas fa-mobile-screen-button"></i><span>User Reports</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Alerts" asp-action="Index"
                       class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Alerts" ? "active" : "")">
                        <i class="fas fa-triangle-exclamation"></i><span>Alerts</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="RiskMonitoring" asp-action="Index"
                       class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Risk" ? "active" : "")">
                        <i class="fas fa-map-location-dot"></i><span>Risk Monitoring</span>
                    </a>
                </li>
            }
            <li>
                <a asp-controller="EmergencyContacts" asp-action="Index"
                   class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Contacts" ? "active" : "")">
                    <i class="fas fa-phone-volume"></i><span>Emergency Contacts</span>
                </a>
            </li>

            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
            {
                <li class="nav-label">Administration</li>
                <li>
                    <a asp-controller="UserManagement" asp-action="Index"
                       class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Users" ? "active" : "")">
                        <i class="fas fa-users-gear"></i><span>User Management</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="DisasterTypes" asp-action="Index"
                       class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "DisasterTypes" ? "active" : "")">
                        <i class="fas fa-biohazard"></i><span>Disaster Types</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="AlertCategories" asp-action="Index"
                       class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "AlertCategories" ? "active" : "")">
                        <i class="fas fa-bell"></i><span>Alert Categories</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Analytics" asp-action="Index"
                       class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Analytics" ? "active" : "")">
                        <i class="fas fa-chart-line"></i><span>Analytics</span>
                    </a>
                </li>
            }

            <li class="nav-label">Account</li>
            <li>
                <a asp-controller="Notifications" asp-action="Index"
                   class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Notifications" ? "active" : "")">
                    <i class="fas fa-bell"></i><span>Notifications</span>
                    @await Component.InvokeAsync("NotificationCount")
                </a>
            </li>
            <li>
                <a asp-controller="Account" asp-action="Profile"
                   class="sidebar-link @(ViewData["ActivePage"]?.ToString() == "Profile" ? "active" : "")">
                    <i class="fas fa-circle-user"></i><span>My Profile</span>
                </a>
            </li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-link btn-sidebar-logout">
                        <i class="fas fa-right-from-bracket"></i><span>Sign Out</span>
                    </button>
                </form>
            </li>
        </ul>

        <div class="sidebar-footer">
            <small>PEWS v1.0 &copy; 2025 Puntland</small>
        </div>
    </nav>

    <div id="main-wrapper">
        <div class="hazard-stripe"></div>
        <header class="pews-topbar">
            <button id="sidebarToggle" class="topbar-btn">
                <i class="fas fa-bars"></i>
            </button>
            <span class="topbar-title d-none d-md-inline">Puntland Early Warning System</span>
            <div class="ms-auto d-flex align-items-center gap-2">
                <a asp-controller="Notifications" asp-action="Index" class="topbar-btn topbar-notif-btn" title="Notifications">
                    <i class="fas fa-bell"></i>
                    @await Component.InvokeAsync("NotificationCount")
                </a>
                <div class="dropdown">
                    <button class="topbar-user dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-circle-user me-1"></i>
                        <span class="d-none d-sm-inline">@User.Identity?.Name?.Split('@')[0]</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li class="dropdown-header px-3 py-2 fw-semibold">@User.Identity?.Name</li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="fas fa-user me-2 text-primary"></i>My Profile</a></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="fas fa-key me-2 text-warning"></i>Change Password</a></li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="fas fa-right-from-bracket me-2"></i>Sign Out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="pews-content">
            @if (ViewData["PageTitle"] != null)
            {
                <div class="page-header">
                    <div>
                        <h1 class="page-title">@ViewData["PageTitle"]</h1>
                        @if (ViewData["Breadcrumb"] != null)
                        {
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0">
                                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index"><i class="fas fa-house-chimney me-1"></i>Home</a></li>
                                    @Html.Raw(ViewData["Breadcrumb"])
                                </ol>
                            </nav>
                        }
                    </div>
                    @if (ViewData["PageActions"] != null)
                    {
                        <div class="page-actions">@Html.Raw(ViewData["PageActions"])</div>
                    }
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-circle-check me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-circle-xmark me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-circle-info me-2"></i>@TempData["Info"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fas fa-triangle-exclamation me-2"></i>@TempData["Warning"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>
}
else
{
    <div class="auth-wrapper">
        @RenderBody()
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="~/js/pews.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
