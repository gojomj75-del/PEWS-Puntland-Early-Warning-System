@model PEWS.ViewModels.Account.ForgotPasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-card">
    <div class="auth-logo">
        <i class="fas fa-envelope-open-text"></i>
    </div>
    <h1 class="auth-title">Forgot Password</h1>
    <p class="auth-subtitle">Enter your email and we'll send you a reset link</p>

    <form asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

        <div class="mb-4">
            <label asp-for="Email" class="form-label">Email Address</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                <input asp-for="Email" class="form-control" placeholder="you@example.so" />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-pews-primary w-100 py-2">
            <i class="fas fa-paper-plane me-2"></i>Send Reset Link
        </button>
    </form>

    <hr class="my-4" />
    <p class="text-center small text-muted mb-0">
        <a asp-action="Login" class="fw-semibold text-primary"><i class="fas fa-arrow-left me-1"></i>Back to Sign In</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
