@model PEWS.ViewModels.Account.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign In";
}

<div class="auth-card">
    <div class="auth-logo">
        <i class="fas fa-shield-halved"></i>
    </div>
    <h1 class="auth-title">PEWS</h1>
    <p class="auth-subtitle">Puntland Early Warning System<br /><small>Government Secure Portal</small></p>

    @if (ViewData["CitizenBlocked"] is true)
    {
        <div class="alert alert-warning small">
            <i class="fas fa-mobile-screen-button me-1"></i>
            You were signed out — Citizen accounts aren't used on this portal. Please use the PEWS mobile app instead.
        </div>
    }

    <form asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" style="display:none" id="validationSummary">
            <ul class="mb-0 ps-3">
                <div asp-validation-summary="ModelOnly"></div>
            </ul>
        </div>

        <script>
            var vs = document.getElementById('validationSummary');
            if (vs && vs.querySelector('li')) vs.style.display = '';
        </script>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email Address</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                <input asp-for="Email" class="form-control" placeholder="you@gov.so" autocomplete="email" />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" id="passwordInput" />
                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword()">
                    <i class="fas fa-eye" id="eyeIcon"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                <label asp-for="RememberMe" class="form-check-label small">Remember me</label>
            </div>
            <a asp-action="ForgotPassword" class="small text-primary">Forgot password?</a>
        </div>

        <button type="submit" class="btn btn-pews-primary w-100 py-2">
            <i class="fas fa-right-to-bracket me-2"></i>Sign In
        </button>
    </form>

    <hr class="my-4" />
    <p class="text-center small text-muted mb-0">
        Citizen? Use the PEWS mobile app instead.
        <a asp-action="Register" class="fw-semibold text-primary">Learn more</a>
    </p>

    <div class="text-center mt-4 pt-3 border-top">
        <small class="text-muted">
            <i class="fas fa-lock me-1"></i>Secure Government Portal — Puntland, Somalia
        </small>
    </div>
</div>

@section Scripts {
<script>
    function togglePassword() {
        var inp = document.getElementById('passwordInput');
        var icon = document.getElementById('eyeIcon');
        if (inp.type === 'password') {
            inp.type = 'text';
            icon.className = 'fas fa-eye-slash';
        } else {
            inp.type = 'password';
            icon.className = 'fas fa-eye';
        }
    }
    // Show validation summary if it has content
    var ul = document.querySelector('#validationSummary ul');
    if (ul && ul.children.length > 0) {
        document.getElementById('validationSummary').style.display = '';
    }
</script>
<partial name="_ValidationScriptsPartial" />
}
