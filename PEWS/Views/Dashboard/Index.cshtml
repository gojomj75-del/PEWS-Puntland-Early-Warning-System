@model PEWS.ViewModels.Dashboard.DashboardViewModel
@using PEWS.Models.Enums
@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";

    var urgentAlerts = Model.ActiveAlertsList
        .Where(a => a.Severity == SeverityLevel.Critical || a.Severity == SeverityLevel.High)
        .OrderByDescending(a => a.Severity)
        .ToList();
}

@if (urgentAlerts.Any())
{
    var top = urgentAlerts.First();
    <div class="alert-banner">
        <div class="siren-icon"><i class="fas fa-tower-broadcast"></i></div>
        <div class="banner-body">
            <div class="banner-label">
                <i class="fas fa-triangle-exclamation me-1"></i>@top.Severity Alert Active
                @(urgentAlerts.Count > 1 ? $"— {urgentAlerts.Count} urgent alerts in effect" : "")
            </div>
            <div class="banner-text">@top.Title @(top.Region != null ? "— " + top.Region.Name : "")</div>
        </div>
        <a asp-controller="Alerts" asp-action="Index" class="btn btn-banner">View Alerts</a>
    </div>
}

<!-- Stat Cards -->
<div class="row g-4 mb-4">
    <div class="col-6 col-lg-3">
        <div class="stat-card border-primary">
            <div class="stat-icon bg-primary-soft"><i class="fas fa-users"></i></div>
            <div class="stat-value">@Model.TotalUsers</div>
            <div class="stat-label">Total Users</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card border-danger">
            <div class="stat-icon bg-danger-soft"><i class="fas fa-file-circle-exclamation"></i></div>
            <div class="stat-value">@Model.TotalReports</div>
            <div class="stat-label">Total Reports</div>
            <div class="stat-change text-warning">
                <i class="fas fa-clock me-1"></i>@Model.PendingReports pending review
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card border-warning">
            <div class="stat-icon bg-warning-soft"><i class="fas fa-triangle-exclamation"></i></div>
            <div class="stat-value">@Model.ActiveAlerts</div>
            <div class="stat-label">Active Alerts</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card border-success">
            <div class="stat-icon bg-success-soft"><i class="fas fa-map-location-dot"></i></div>
            <div class="stat-value">@Model.HighRiskAreas</div>
            <div class="stat-label">High Risk Areas</div>
            <div class="stat-change text-muted">
                <i class="fas fa-location-dot me-1"></i>@Model.TotalRegions regions monitored
            </div>
        </div>
    </div>
</div>

<!-- Secondary Stats -->
<div class="row g-4 mb-4">
    <div class="col-6 col-md-3">
        <div class="pews-card text-center py-3">
            <div class="fw-bold fs-3 text-success">@Model.VerifiedReports</div>
            <div class="text-muted small">Verified Reports</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="pews-card text-center py-3">
            <div class="fw-bold fs-3 text-warning">@Model.PendingReports</div>
            <div class="text-muted small">Pending Review</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="pews-card text-center py-3">
            <div class="fw-bold fs-3 text-primary">@Model.ActiveAlerts</div>
            <div class="text-muted small">Live Alerts</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="pews-card text-center py-3">
            <div class="fw-bold fs-3 text-info">@Model.TotalRegions</div>
            <div class="text-muted small">Regions</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="DisasterReports" asp-action="Index" class="pews-card text-center py-3 d-block text-decoration-none">
            <div class="fw-bold fs-3 text-pews-primary">@Model.TotalDisasterRecords</div>
            <div class="text-muted small">Disaster Records</div>
        </a>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="pews-card h-100">
            <div class="card-header">
                <span><i class="fas fa-chart-line me-2 text-primary"></i>Reports — Last 12 Months</span>
            </div>
            <div class="card-body">
                <canvas id="reportsMonthChart" height="80"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="pews-card h-100">
            <div class="card-header">
                <span><i class="fas fa-chart-pie me-2 text-primary"></i>Reports by Type</span>
            </div>
            <div class="card-body d-flex align-items-center">
                <canvas id="reportTypeChart" height="180"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="pews-card h-100">
            <div class="card-header">
                <span><i class="fas fa-chart-bar me-2 text-warning"></i>Reports by Severity</span>
            </div>
            <div class="card-body">
                <canvas id="severityChart" height="180"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="pews-card h-100">
            <div class="card-header">
                <span><i class="fas fa-map me-2 text-success"></i>Reports by Region</span>
            </div>
            <div class="card-body">
                <canvas id="regionChart" height="100"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Active Alerts -->
@if (Model.ActiveAlertsList.Any())
{
    <div class="pews-card mb-4">
        <div class="card-header">
            <span><i class="fas fa-triangle-exclamation me-2 text-danger"></i>Active Alerts</span>
            <a asp-controller="Alerts" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
        </div>
        <div class="card-body p-0">
            <div class="list-group list-group-flush">
                @foreach (var alert in Model.ActiveAlertsList)
                {
                    <div class="list-group-item px-4 py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width:38px;height:38px;background:@alert.AlertCategory.Color + '22';color:@alert.AlertCategory.Color">
                                <i class="@alert.AlertCategory.IconClass"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@alert.Title</div>
                                <small class="text-muted">@alert.AlertCategory.Name @(alert.Region != null ? "— " + alert.Region.Name : "")</small>
                            </div>
                            @{
                                var sevClass = alert.Severity switch {
                                    SeverityLevel.Low => "badge-severity-low",
                                    SeverityLevel.Medium => "badge-severity-medium",
                                    SeverityLevel.High => "badge-severity-high",
                                    _ => "badge-severity-critical"
                                };
                            }
                            <span class="badge @sevClass rounded-pill">@alert.Severity</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<!-- Recent Reports -->
<div class="pews-card">
    <div class="card-header">
        <span><i class="fas fa-mobile-screen-button me-2 text-primary"></i>Recent User Reports</span>
        <div class="d-flex gap-2">
            <a asp-controller="DisasterReports" asp-action="Create" class="btn btn-sm btn-pews-primary">
                <i class="fas fa-plus me-1"></i>New Disaster Record
            </a>
            <a asp-controller="UserReports" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All</a>
        </div>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentReports.Any())
        {
            <div class="table-responsive">
                <table class="table pews-table mb-0">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Severity</th>
                            <th>Status</th>
                            <th>Region</th>
                            <th>Reported</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model.RecentReports)
                        {
                            var sev = report.Severity switch {
                                SeverityLevel.Low => "badge-severity-low",
                                SeverityLevel.Medium => "badge-severity-medium",
                                SeverityLevel.High => "badge-severity-high",
                                _ => "badge-severity-critical"
                            };
                            var st = report.Status switch {
                                ReportStatus.Pending => "badge-status-pending",
                                ReportStatus.UnderReview => "badge-status-review",
                                ReportStatus.Verified => "badge-status-verified",
                                ReportStatus.Resolved => "badge-status-resolved",
                                _ => "badge-status-rejected"
                            };
                            <tr>
                                <td class="fw-semibold">@report.Title</td>
                                <td>
                                    <span style="color:@report.DisasterType.Color">
                                        <i class="@report.DisasterType.IconClass me-1"></i>@report.DisasterType.Name
                                    </span>
                                </td>
                                <td><span class="badge @sev">@report.Severity</span></td>
                                <td><span class="badge @st">@report.Status</span></td>
                                <td class="text-muted">@(report.Region?.Name ?? "—")</td>
                                <td class="text-muted small">@report.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    <a asp-controller="UserReports" asp-action="Details" asp-route-id="@report.Id"
                                       class="btn btn-sm btn-outline-primary">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-mobile-screen-button fs-2 mb-3 d-block opacity-25"></i>
                No citizen reports yet.
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    // -- Monthly Reports Chart --
    const monthLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReportsByMonth.Keys.ToArray()));
    const monthData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReportsByMonth.Values.ToArray()));

    new Chart(document.getElementById('reportsMonthChart'), {
        type: 'line',
        data: {
            labels: monthLabels,
            datasets: [{
                label: 'Reports',
                data: monthData,
                borderColor: '#1a3a5c',
                backgroundColor: 'rgba(26,58,92,0.08)',
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#1a3a5c',
                pointRadius: 4
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f0f4f8' } },
                x: { grid: { display: false } }
            }
        }
    });

    // -- Disaster Type Doughnut --
    const typeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReportsByType.Keys.ToArray()));
    const typeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReportsByType.Values.ToArray()));
    const typeColors = ['#0d6efd','#ffc107','#6f42c1','#dc3545','#fd7e14','#6c757d','#20c997','#795548'];

    new Chart(document.getElementById('reportTypeChart'), {
        type: 'doughnut',
        data: {
            labels: typeLabels.length ? typeLabels : ['No Data'],
            datasets: [{
                data: typeData.length ? typeData : [1],
                backgroundColor: typeColors,
                borderWidth: 2, borderColor: '#fff'
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 12, padding: 12, font: { size: 11 } } }
            },
            cutout: '65%'
        }
    });

    // -- Severity Bar Chart --
    const sevLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReportsBySeverity.Keys.ToArray()));
    const sevData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReportsBySeverity.Values.ToArray()));
    const sevColors = { Low: '#00b894', Medium: '#fdcb6e', High: '#fd7e14', Critical: '#d63031' };
    const sevBg = sevLabels.map(l => sevColors[l] || '#6c757d');

    new Chart(document.getElementById('severityChart'), {
        type: 'bar',
        data: {
            labels: sevLabels.length ? sevLabels : ['No Data'],
            datasets: [{
                data: sevData.length ? sevData : [0],
                backgroundColor: sevBg, borderRadius: 6, borderSkipped: false
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f0f4f8' } },
                x: { grid: { display: false } }
            }
        }
    });

    // -- Region Bar Chart --
    const regionLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReportsByRegion.Keys.ToArray()));
    const regionData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReportsByRegion.Values.ToArray()));

    new Chart(document.getElementById('regionChart'), {
        type: 'bar',
        data: {
            labels: regionLabels.length ? regionLabels : ['No Data'],
            datasets: [{
                label: 'Reports',
                data: regionData.length ? regionData : [0],
                backgroundColor: '#1a3a5c',
                borderRadius: 6
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                x: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#f0f4f8' } },
                y: { grid: { display: false } }
            }
        }
    });
</script>
}
