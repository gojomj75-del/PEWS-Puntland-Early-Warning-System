@model PEWS.ViewModels.AlertViewModel
@using PEWS.Models.Enums
@{
    ViewData["Title"] = "Edit Alert";
    ViewData["PageTitle"] = "Edit Alert";
    ViewData["ActivePage"] = "Alerts";
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="pews-card">
                <div class="card-header"><i class="fas fa-pen me-2 text-primary"></i>Edit Alert</div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Message" class="form-label">Message <span class="text-danger">*</span></label>
                        <textarea asp-for="Message" class="form-control" rows="6"></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="AlertCategoryId" class="form-label">Category</label>
                            <select asp-for="AlertCategoryId" asp-items="Model.AlertCategories" class="form-select">
                                <option value="">— Select —</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Severity" class="form-label">Severity</label>
                            <select asp-for="Severity" class="form-select">
                                <option value="1">Low</option>
                                <option value="2">Medium</option>
                                <option value="3">High</option>
                                <option value="4">Critical</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="pews-card mb-4">
                <div class="card-header"><i class="fas fa-map-pin me-2 text-danger"></i>Target Area</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="RegionId" class="form-label">Region</label>
                        <select asp-for="RegionId" asp-items="Model.Regions" class="form-select">
                            <option value="">— All Regions —</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DistrictId" class="form-label">District</label>
                        <select asp-for="DistrictId" asp-items="Model.Districts" class="form-select">
                            <option value="">— All Districts —</option>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label asp-for="ExpiresAt" class="form-label">Expires At</label>
                        <input asp-for="ExpiresAt" type="datetime-local" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-pews-primary py-2">
                    <i class="fas fa-floppy-disk me-2"></i>Save Changes
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
