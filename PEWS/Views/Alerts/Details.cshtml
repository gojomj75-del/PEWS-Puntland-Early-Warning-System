@model PEWS.Models.Alert
@using PEWS.Models.Enums
@{
    ViewData["Title"] = Model.Title;
    ViewData["PageTitle"] = "Alert Details";
    ViewData["ActivePage"] = "Alerts";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/Alerts\">Alerts</a></li><li class=\"breadcrumb-item active\">Details</li>";

    var sevClass = Model.Severity switch {
        SeverityLevel.Low => "badge-severity-low",
        SeverityLevel.Medium => "badge-severity-medium",
        SeverityLevel.High => "badge-severity-high",
        _ => "badge-severity-critical"
    };
    var stClass = Model.Status switch {
        AlertStatus.Draft => "badge-status-draft",
        AlertStatus.Published => "badge-status-published",
        _ => "badge-status-expired"
    };
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="pews-card">
            <div class="card-header">
                <div>
                    <span class="badge @sevClass me-2">@Model.Severity</span>
                    <span class="badge @stClass">@Model.Status</span>
                </div>
                @if ((User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("EmergencyOfficer")) && !Model.IsPublished)
                {
                    <form asp-action="Publish" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-success"
                                data-confirm="Publish this alert? All users will be notified immediately.">
                            <i class="fas fa-broadcast-tower me-1"></i>Publish
                        </button>
                    </form>
                }
            </div>
            <div class="card-body">
                <h4 class="fw-bold mb-2 text-pews-primary">@Model.Title</h4>

                <div class="d-flex align-items-center gap-2 mb-4">
                    <span style="background:@Model.AlertCategory.Color + '22';color:@Model.AlertCategory.Color" class="badge rounded-pill px-3">
                        <i class="@Model.AlertCategory.IconClass me-1"></i>@Model.AlertCategory.Name
                    </span>
                    @if (Model.Region != null)
                    {
                        <span class="badge bg-light text-dark border"><i class="fas fa-location-dot me-1"></i>@Model.Region.Name</span>
                    }
                    <span class="badge bg-light text-dark border"><i class="fas fa-eye me-1"></i>@Model.ViewCount views</span>
                </div>

                <div class="alert" style="background:#fff8e1;border-left:4px solid var(--pews-accent);border-radius:8px;">
                    <p class="mb-0" style="white-space:pre-line">@Model.Message</p>
                </div>

                @if (Model.ExpiresAt.HasValue)
                {
                    <div class="mt-3 small text-muted">
                        <i class="fas fa-clock me-1"></i>Expires: @Model.ExpiresAt.Value.ToString("dd MMMM yyyy HH:mm") UTC
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="pews-card mb-4">
            <div class="card-header"><i class="fas fa-circle-info me-2 text-primary"></i>Alert Info</div>
            <div class="card-body">
                <dl>
                    <dt class="text-muted small">Created By</dt>
                    <dd class="fw-semibold">@Model.CreatedBy?.FullName</dd>
                    <dt class="text-muted small">Created At</dt>
                    <dd>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>
                    @if (Model.PublishedAt.HasValue)
                    {
                        <dt class="text-muted small">Published At</dt>
                        <dd class="text-success">@Model.PublishedAt.Value.ToString("dd MMM yyyy HH:mm")</dd>
                    }
                    @if (Model.District != null)
                    {
                        <dt class="text-muted small">District</dt>
                        <dd>@Model.District.Name</dd>
                    }
                </dl>
            </div>
        </div>

        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin") || User.IsInRole("EmergencyOfficer"))
        {
            <div class="d-grid gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                    <i class="fas fa-pen me-2"></i>Edit Alert
                </a>
                @if (Model.IsPublished && (User.IsInRole("SuperAdmin") || User.IsInRole("Admin")))
                {
                    <form asp-action="Expire" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-warning w-100"
                                data-confirm="Mark this alert as expired?">
                            <i class="fas fa-clock me-2"></i>Mark Expired
                        </button>
                    </form>
                }
                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
                {
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100"
                                data-confirm="Delete this alert permanently?">
                            <i class="fas fa-trash me-2"></i>Delete Alert
                        </button>
                    </form>
                }
            </div>
        }
    </div>
</div>
