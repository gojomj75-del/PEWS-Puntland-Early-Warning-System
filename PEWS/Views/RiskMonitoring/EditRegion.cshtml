@model PEWS.ViewModels.RegionViewModel
@using PEWS.Models.Enums
@{
    ViewData["Title"] = "Edit Region";
    ViewData["PageTitle"] = "Edit Region";
    ViewData["ActivePage"] = "Risk";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/RiskMonitoring\">Risk Monitoring</a></li><li class=\"breadcrumb-item active\">Edit Region</li>";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="pews-card">
            <div class="card-header"><i class="fas fa-pen me-2 text-primary"></i>Edit Region</div>
            <div class="card-body">
                <form asp-action="EditRegion" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label">Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Code" class="form-label">Code</label>
                            <input asp-for="Code" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="RiskLevel" class="form-label">Risk Level</label>
                            <select asp-for="RiskLevel" class="form-select">
                                @foreach (RiskLevel rl in Enum.GetValues(typeof(RiskLevel)))
                                {
                                    <option value="@((int)rl)" selected="@(rl == Model.RiskLevel)">@rl</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Latitude" class="form-label">Latitude</label>
                            <input asp-for="Latitude" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Longitude" class="form-label">Longitude</label>
                            <input asp-for="Longitude" class="form-control" />
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>

                    <div class="d-flex gap-2 justify-content-between">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-pews-primary"><i class="fas fa-floppy-disk me-2"></i>Save</button>
                            <a asp-action="RegionDetails" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </div>
                </form>

                <hr class="my-4" />

                <form asp-action="DeleteRegion" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger"
                            data-confirm="Permanently delete @Model.Name? This is only possible if it has no districts or linked records.">
                        <i class="fas fa-trash me-2"></i>Delete Region
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
