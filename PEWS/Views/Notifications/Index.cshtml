@model IEnumerable<PEWS.Models.Notification>
@using PEWS.Models.Enums
@{
    ViewData["Title"] = "Notifications";
    ViewData["PageTitle"] = "Notifications";
    ViewData["ActivePage"] = "Notifications";
}

<div class="pews-card">
    <div class="card-header">
        <span>
            <i class="fas fa-bell me-2 text-primary"></i>Notifications
            @if ((int)ViewBag.UnreadCount > 0)
            {
                <span class="badge bg-danger ms-1">@ViewBag.UnreadCount unread</span>
            }
        </span>
        <div class="d-flex gap-2">
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
            {
                <a asp-action="Compose" class="btn btn-sm btn-pews-primary">
                    <i class="fas fa-paper-plane me-1"></i>Compose
                </a>
            }
            @if (Model.Any(n => !n.IsRead))
            {
                <form asp-action="MarkAllRead" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-check-double me-1"></i>Mark All Read
                    </button>
                </form>
            }
        </div>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var notif in Model)
                {
                    var icon = notif.Type switch {
                        NotificationType.DisasterAlert => "fas fa-triangle-exclamation text-danger",
                        NotificationType.ReportUpdate => "fas fa-file-circle-check text-primary",
                        NotificationType.WeatherAlert => "fas fa-cloud-bolt text-warning",
                        _ => "fas fa-bell text-secondary"
                    };
                    <div class="list-group-item px-4 py-3 @(!notif.IsRead ? "" : "opacity-75")"
                         style="@(!notif.IsRead ? "background:#fafbff;border-left:3px solid var(--pews-primary)" : "")">
                        <div class="d-flex align-items-start gap-3">
                            <div class="mt-1 flex-shrink-0">
                                <i class="@icon fs-5"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="fw-semibold @(!notif.IsRead ? "" : "text-muted")">
                                        @notif.Title
                                        @if (!notif.IsRead)
                                        { <span class="badge bg-primary ms-2 small">New</span> }
                                    </div>
                                    <span class="text-muted small flex-shrink-0 ms-2">@notif.CreatedAt.ToString("dd MMM HH:mm")</span>
                                </div>
                                <p class="text-muted small mb-1 mt-1">@notif.Message</p>
                                <div class="d-flex gap-2">
                                    @if (!string.IsNullOrEmpty(notif.ActionUrl))
                                    {
                                        <a href="@notif.ActionUrl" class="btn btn-sm btn-outline-primary">View</a>
                                    }
                                    @if (!notif.IsRead)
                                    {
                                        <form asp-action="MarkRead" asp-route-id="@notif.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Mark Read</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-bell-slash fs-2 opacity-25 d-block mb-3"></i>
                You have no notifications.
            </div>
        }
    </div>
</div>
