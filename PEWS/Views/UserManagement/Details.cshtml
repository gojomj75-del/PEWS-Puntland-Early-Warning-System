@model PEWS.Models.ApplicationUser
@{
    ViewData["Title"] = "User Details";
    ViewData["PageTitle"] = "User Details";
    ViewData["ActivePage"] = "Users";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/UserManagement\">Users</a></li><li class=\"breadcrumb-item active\">Details</li>";

    var userRoles = (IList<string>)ViewBag.Roles;
    var allRoles = (IList<string>)ViewBag.AllRoles;
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="pews-card text-center mb-4">
            <div class="card-body py-4">
                <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center fw-bold"
                     style="width:80px;height:80px;background:var(--pews-primary);color:var(--pews-accent);font-size:2rem;">
                    @Model.FirstName.Substring(0, 1).ToUpper()
                </div>
                <h5 class="fw-bold">@Model.FullName</h5>
                <p class="text-muted small">@Model.Email</p>
                @if (Model.IsActive)
                { <span class="badge bg-success px-3">Active</span> }
                else
                { <span class="badge bg-secondary px-3">Inactive</span> }
                <div class="mt-2">
                    @foreach (var r in userRoles)
                    {
                        var c = r switch { "SuperAdmin" => "bg-danger", "Admin" => "bg-warning text-dark", "EmergencyOfficer" => "bg-primary", _ => "bg-secondary" };
                        <span class="badge @c me-1">@r</span>
                    }
                </div>
            </div>
        </div>

        <div class="pews-card mb-4">
            <div class="card-header"><i class="fas fa-circle-info me-2"></i>Account Info</div>
            <div class="card-body">
                <dl class="mb-0">
                    <dt class="text-muted small">Phone</dt>
                    <dd>@(Model.PhoneNumber ?? "—")</dd>
                    <dt class="text-muted small">City / Region</dt>
                    <dd>@(Model.City ?? "—") / @(Model.Region ?? "—")</dd>
                    <dt class="text-muted small">Joined</dt>
                    <dd>@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
                    <dt class="text-muted small">Last Login</dt>
                    <dd>@(Model.LastLoginAt.HasValue ? Model.LastLoginAt.Value.ToString("dd MMM yyyy HH:mm") : "Never")</dd>
                </dl>
            </div>
        </div>

        <div class="d-grid gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary w-100">
                <i class="fas fa-pen me-2"></i>Edit Details
            </a>
            <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn @(Model.IsActive ? "btn-outline-warning" : "btn-outline-success") w-100"
                        data-confirm="@(Model.IsActive ? "Deactivate this user account?" : "Activate this user account?")">
                    <i class="fas fa-@(Model.IsActive ? "user-slash" : "user-check") me-2"></i>
                    @(Model.IsActive ? "Deactivate Account" : "Activate Account")
                </button>
            </form>

            @if (User.IsInRole("SuperAdmin"))
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger w-100"
                            data-confirm="Permanently delete @Model.FullName? All their data will be lost.">
                        <i class="fas fa-trash me-2"></i>Delete User
                    </button>
                </form>
            }
        </div>
    </div>

    @if (User.IsInRole("SuperAdmin"))
    {
        <div class="col-lg-8">
            <div class="pews-card">
                <div class="card-header"><i class="fas fa-user-shield me-2 text-primary"></i>Role Management</div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var role in allRoles)
                        {
                            var hasRole = userRoles.Contains(role);
                            var rColor = role switch {
                                "SuperAdmin" => "danger",
                                "Admin" => "warning",
                                "EmergencyOfficer" => "primary",
                                _ => "secondary"
                            };
                            <div class="col-md-6">
                                <div class="border rounded-3 p-3 d-flex align-items-center justify-content-between">
                                    <div>
                                        <span class="badge bg-@rColor @(role == "Admin" ? "text-dark" : "")">@role</span>
                                        @if (hasRole)
                                        {
                                            <i class="fas fa-circle-check text-success ms-2"></i>
                                        }
                                    </div>
                                    <form asp-action="AssignRole" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@Model.Id" />
                                        <input type="hidden" name="roleName" value="@role" />
                                        <input type="hidden" name="action" value="@(hasRole ? "remove" : "add")" />
                                        <button type="submit" class="btn btn-sm @(hasRole ? "btn-outline-danger" : "btn-outline-success")"
                                                data-confirm="@(hasRole ? "Remove role " + role + "?" : "Assign role " + role + "?")">
                                            @if (hasRole) { <span><i class="fas fa-minus me-1"></i>Remove</span> }
                                            else { <span><i class="fas fa-plus me-1"></i>Assign</span> }
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
