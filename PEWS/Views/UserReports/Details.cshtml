@model PEWS.Models.UserReport
@using PEWS.Models.Enums
@{
    ViewData["Title"] = Model.Title;
    ViewData["PageTitle"] = "User Report Details";
    ViewData["ActivePage"] = "UserReports";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/UserReports\">User Reports</a></li><li class=\"breadcrumb-item active\">Details</li>";

    var sevClass = Model.Severity switch {
        SeverityLevel.Low => "badge-severity-low",
        SeverityLevel.Medium => "badge-severity-medium",
        SeverityLevel.High => "badge-severity-high",
        _ => "badge-severity-critical"
    };
    var stClass = Model.Status switch {
        ReportStatus.Pending => "badge-status-pending",
        ReportStatus.UnderReview => "badge-status-review",
        ReportStatus.Verified => "badge-status-verified",
        ReportStatus.Resolved => "badge-status-resolved",
        _ => "badge-status-rejected"
    };
}

<div class="row g-4">
    <div class="col-lg-8">
        <!-- Main Info Card -->
        <div class="pews-card mb-4">
            <div class="card-header">
                <div>
                    <span class="badge bg-primary me-2"><i class="fas fa-mobile-screen-button me-1"></i>Citizen Report</span>
                    <span class="badge @sevClass me-2">@Model.Severity</span>
                    <span class="badge @stClass">@Model.Status</span>
                    @if (Model.IsVerified)
                    { <span class="badge bg-success ms-2"><i class="fas fa-circle-check me-1"></i>Verified</span> }
                </div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
                    <i class="fas fa-pen me-1"></i>Edit
                </a>
            </div>
            <div class="card-body">
                <h4 class="fw-bold mb-3 text-pews-primary">@Model.Title</h4>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <small class="text-muted d-block fw-semibold text-uppercase" style="letter-spacing:.05em">Disaster Type</small>
                        <span style="color:@Model.DisasterType.Color">
                            <i class="@Model.DisasterType.IconClass me-1"></i>@Model.DisasterType.Name
                        </span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block fw-semibold text-uppercase" style="letter-spacing:.05em">Incident Date</small>
                        @Model.IncidentDate.ToString("dd MMMM yyyy — HH:mm") UTC
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block fw-semibold text-uppercase" style="letter-spacing:.05em">Submitted</small>
                        @Model.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC
                    </div>
                </div>

                <h6 class="fw-bold text-pews-primary mb-2">Description</h6>
                <p class="text-muted" style="white-space:pre-line">@Model.Description</p>

                @if (Model.Images.Any())
                {
                    <h6 class="fw-bold text-pews-primary mb-3 mt-4">Evidence Photos</h6>
                    <div class="row g-3">
                        @foreach (var img in Model.Images)
                        {
                            <div class="col-4 col-md-3">
                                <a href="@img.ImagePath" target="_blank">
                                    <img src="@img.ImagePath" class="img-fluid rounded" style="height:120px;width:100%;object-fit:cover;" alt="Evidence" />
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Verification Pipeline: Review -> Verify -> Approve/Reject -> Resolve -->
        <div class="pews-card">
            <div class="card-header"><i class="fas fa-clipboard-check me-2 text-primary"></i>Verification Pipeline</div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.VerificationNotes))
                {
                    <div class="alert alert-info py-2 mb-3">
                        <strong>Verification Notes:</strong> @Model.VerificationNotes
                    </div>
                }

                @if (Model.Status == ReportStatus.Pending)
                {
                    <p class="text-muted small">This report is awaiting review.</p>
                    <form asp-action="StartReview" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="fas fa-magnifying-glass me-2"></i>Start Review
                        </button>
                    </form>
                }
                else if (Model.Status == ReportStatus.UnderReview)
                {
                    <form method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">Verification Notes</label>
                            <input name="notes" class="form-control" placeholder="Add notes for this decision..." />
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" asp-action="Approve" asp-route-id="@Model.Id" class="btn btn-success">
                                <i class="fas fa-circle-check me-2"></i>Approve
                            </button>
                            <button type="submit" asp-action="Reject" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                                <i class="fas fa-circle-xmark me-2"></i>Reject
                            </button>
                        </div>
                    </form>
                }
                else if (Model.Status == ReportStatus.Verified)
                {
                    <p class="text-success small mb-3"><i class="fas fa-circle-check me-1"></i>This report has been verified and approved.</p>
                    <form asp-action="Resolve" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-success">
                            <i class="fas fa-flag-checkered me-2"></i>Mark Resolved
                        </button>
                    </form>
                }
                else if (Model.Status == ReportStatus.Rejected)
                {
                    <p class="text-danger small mb-0"><i class="fas fa-circle-xmark me-1"></i>This report was rejected and requires no further action.</p>
                }
                else if (Model.Status == ReportStatus.Resolved)
                {
                    <p class="text-muted small mb-0"><i class="fas fa-flag-checkered me-1"></i>This incident has been resolved.</p>
                }
            </div>
        </div>
    </div>

    <!-- Right Column -->
    <div class="col-lg-4">
        <div class="pews-card mb-4">
            <div class="card-header"><i class="fas fa-map-pin me-2 text-danger"></i>Location</div>
            <div class="card-body">
                <dl class="mb-0">
                    @if (Model.Region != null)
                    {
                        <dt class="text-muted small">Region</dt>
                        <dd class="fw-semibold">@Model.Region.Name</dd>
                    }
                    @if (Model.District != null)
                    {
                        <dt class="text-muted small">District</dt>
                        <dd class="fw-semibold">@Model.District.Name</dd>
                    }
                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        <dt class="text-muted small">Address</dt>
                        <dd>@Model.Location</dd>
                    }
                    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                    {
                        <dt class="text-muted small">GPS Coordinates</dt>
                        <dd class="font-monospace small">@Model.Latitude.Value.ToString("F4"), @Model.Longitude.Value.ToString("F4")</dd>
                    }
                </dl>
            </div>
        </div>

        <div class="pews-card mb-4">
            <div class="card-header"><i class="fas fa-user me-2 text-primary"></i>Reported By (Citizen)</div>
            <div class="card-body">
                <div class="fw-semibold">@Model.ReportedBy?.FullName</div>
                <div class="text-muted small">@Model.ReportedBy?.Email</div>
            </div>
        </div>

        @if (Model.IsVerified && Model.VerifiedBy != null)
        {
            <div class="pews-card mb-4">
                <div class="card-header"><i class="fas fa-circle-check me-2 text-success"></i>Verified By</div>
                <div class="card-body">
                    <div class="fw-semibold">@Model.VerifiedBy.FullName</div>
                    <div class="text-muted small">@Model.VerifiedAt?.ToString("dd MMM yyyy")</div>
                    @if (!string.IsNullOrEmpty(Model.VerificationNotes))
                    {
                        <p class="mt-2 small text-muted">@Model.VerificationNotes</p>
                    }
                </div>
            </div>
        }

        @if (User.IsInRole("SuperAdmin") || User.IsInRole("Admin"))
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger w-100"
                        data-confirm="Permanently delete this report? This cannot be undone.">
                    <i class="fas fa-trash me-2"></i>Delete Report
                </button>
            </form>
        }
    </div>
</div>
