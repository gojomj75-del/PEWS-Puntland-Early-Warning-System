@model PEWS.ViewModels.DisasterReportViewModel
@using PEWS.Models.Enums
@{
    ViewData["Title"] = "Edit Report";
    ViewData["PageTitle"] = "Edit Disaster Report";
    ViewData["ActivePage"] = "Reports";
    ViewData["Breadcrumb"] = "<li class=\"breadcrumb-item\"><a href=\"/DisasterReports\">Reports</a></li><li class=\"breadcrumb-item active\">Edit</li>";
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="pews-card mb-4">
                <div class="card-header"><i class="fas fa-pen me-2 text-primary"></i>Edit Report Information</div>
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="DisasterTypeId" class="form-label">Disaster Type</label>
                            <select asp-for="DisasterTypeId" asp-items="Model.DisasterTypes" class="form-select">
                                <option value="">— Select —</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Severity" class="form-label">Severity</label>
                            <select asp-for="Severity" class="form-select">
                                <option value="1">Low</option>
                                <option value="2">Medium</option>
                                <option value="3">High</option>
                                <option value="4">Critical</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="IncidentDate" class="form-label">Incident Date</label>
                            <input asp-for="IncidentDate" type="datetime-local" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.ExistingImagePaths.Any())
            {
                <div class="pews-card mb-4">
                    <div class="card-header"><i class="fas fa-images me-2"></i>Existing Photos</div>
                    <div class="card-body">
                        <div class="row g-2">
                            @foreach (var img in Model.ExistingImagePaths)
                            {
                                <div class="col-3">
                                    <img src="@img" class="img-fluid rounded" style="height:80px;width:100%;object-fit:cover;" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="pews-card">
                <div class="card-header"><i class="fas fa-plus me-2"></i>Add More Photos</div>
                <div class="card-body">
                    <input name="Images" type="file" class="form-control" multiple accept="image/*" />
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="pews-card mb-4">
                <div class="card-header"><i class="fas fa-map-pin me-2 text-danger"></i>Location</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="RegionId" class="form-label">Region</label>
                        <select asp-for="RegionId" asp-items="Model.Regions" class="form-select" id="regionSelect">
                            <option value="">— Select Region —</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="DistrictId" class="form-label">District</label>
                        <select asp-for="DistrictId" asp-items="Model.Districts" class="form-select" id="districtSelect">
                            <option value="">— Select District —</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Location" class="form-label">Address</label>
                        <input asp-for="Location" class="form-control" />
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label asp-for="Latitude" class="form-label">Latitude</label>
                            <input asp-for="Latitude" type="number" step="any" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label asp-for="Longitude" class="form-label">Longitude</label>
                            <input asp-for="Longitude" type="number" step="any" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-pews-primary py-2">
                    <i class="fas fa-floppy-disk me-2"></i>Save Changes
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    document.getElementById('regionSelect').addEventListener('change', function () {
        var regionId = this.value;
        var districtSelect = document.getElementById('districtSelect');
        if (!regionId) { districtSelect.innerHTML = '<option value="">— Select District —</option>'; return; }
        fetch('/DisasterReports/GetDistricts?regionId=' + regionId)
            .then(r => r.json())
            .then(data => {
                districtSelect.innerHTML = '<option value="">— Select District —</option>';
                data.forEach(d => districtSelect.innerHTML += '<option value="' + d.id + '">' + d.name + '</option>');
            });
    });
</script>
<partial name="_ValidationScriptsPartial" />
}
